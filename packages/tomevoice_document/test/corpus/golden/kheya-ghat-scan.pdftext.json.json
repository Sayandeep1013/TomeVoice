  "first": [
    "প্রথম পরিচ্ছেদ",
    "হরিপদ মাঝি",
    "নদীর ধারে ছোট একটি গ্রাম, নাম চরপাড়া।",
    "সেই গ্রামে হরিপদ মাঝি থাকত।",
    "তার একটি পুরোনো নৌকা ছিল, আর সেই নৌকায় সে সারাদিন লোক পারাপার করত।"
  ],
  "last": [
    "গোপাল সেদিন থেকে মন দিয়ে পড়ে।",
    "সে বলে, বড় হয়ে আমি ডাক্তার হব, আর বাবার নৌকায় চড়ে ওপারে রোগী দেখতে যাব।",
    "নদী আজও বয়ে চলে।",
    "খেয়াঘাটে এখনও ভোরবেলা ডাক শোনা যায়, কে যাবে ওপারে?",
    "সমাপ্ত"
  ],
