# Dart / Flutter
.dart_tool/
.packages
build/
pubspec.lock
.flutter-plugins
.flutter-plugins-dependencies
*.iml

# Generated by `flutter create` in CI — never committed. See ADR-016: there is
# no local Flutter install, so the platform scaffolding is produced at build
# time and our sources in app/android_overlay/ are laid over it.
app/android/
app/ios/
app/linux/
app/macos/
app/windows/
app/web/
app/.metadata

# Build outputs and spike artefacts. The APK is ~140 MB, well over GitHub's
# 100 MB file limit, and is always reproducible from CI - never commit it.
dist/
*.apk
*.aab

# Spike artefacts pulled from a device
spike-runs/
*.wav
!packages/tomevoice_audio/test/golden/*.wav

# Editors
.idea/
.vscode/
*.swp
.DS_Store
