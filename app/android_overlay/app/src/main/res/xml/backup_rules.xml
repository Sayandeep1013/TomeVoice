<?xml version="1.0" encoding="utf-8"?>
<!-- Android's own backup (Android 11 and older): everything as before, but
     never the keys and passwords (Secrets, AI keys), the AI usage counts or the log of what was sent. -->
<full-backup-content>
    <exclude domain="file" path=".secrets.json" />
    <exclude domain="file" path=".ai_usage.json" />
    <exclude domain="file" path=".ai_log.json" />
</full-backup-content>
